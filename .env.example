# Server
PORT=3000
NODE_ENV=development

# Session (used for flash messages only)
SESSION_SECRET=change-me

# JWT access / refresh token secrets — override these in production
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# MySQL database
MYSQL_DATABASE_URL=mysql://root:root@localhost:3306/spmjdb

# Seed credentials (used by drizzle/seed.js)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me
USER_EMAIL=user@example.org
USER_PASSWORD=change-me

# Razorpay (optional — donations degrade gracefully when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gmail / transactional email (optional — receipt emails are skipped with a
# warning when these are empty; the payment itself is never affected).
# GMAIL_APP_PASSWORD must be a Google App Password (16 chars, from
# https://myaccount.google.com/apppasswords with 2-Step Verification on) —
# a normal account password will NOT work.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional From override — must be a verified "Send mail as" alias of
# GMAIL_USER. Defaults to GMAIL_USER when empty.
MAIL_FROM=
MAIL_FROM_NAME=SPMJ Foundation
MAIL_REPLY_TO=

# Public base URL, used for absolute links in emails (receipt lookup).
APP_BASE_URL=http://localhost:3000

# Base directory for uploaded files (events/blog/gallery subfolders are
# appended automatically). Point this at a mounted volume in production.
UPLOAD_DIR=public/uploads
