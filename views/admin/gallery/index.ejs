<%- include('../head', { title, active: 'gallery' }) %>

    <div class="admin-list-head">
      <div>
        <span class="eyebrow">Gallery</span>
        <h1>Manage albums</h1>
      </div>
      <div class="admin-list-actions">
        <%- include('../../partials/page-size', { pageSize, pageSizeOptions, pageSizeBaseUrl: '/admin/gallery', pageSizeQuery: {} }) %>
        <a href="/admin/gallery/new" class="btn btn-primary">+ Add album</a>
      </div>
    </div>

    <div class="admin-panel">
      <% if (items.length === 0) { %>
        <p class="muted">No albums yet. <a href="/admin/gallery/new" class="link-arrow">Create the first album →</a></p>
      <% } else { %>
        <div class="table-scroll">
          <table class="data-table data-table-rich">
            <thead>
              <tr>
                <th class="col-thumb"></th>
                <th>Album</th>
                <th>Items</th>
                <th>Linked event</th>
                <th>Added</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach((item) => { %>
                <% const isFile = item.mediaUrl.startsWith('/uploads/'); %>
                <tr>
                  <td class="col-thumb">
                    <% if (item.mediaType === 'video') { %>
                      <% if (isFile) { %>
                        <video class="table-thumb" src="<%= item.mediaUrl %>" preload="metadata" muted></video>
                      <% } else { %>
                        <span class="table-thumb placeholder">▶</span>
                      <% } %>
                    <% } else { %>
                      <img class="table-thumb" src="<%= item.mediaUrl %>" alt="" loading="lazy" />
                    <% } %>
                  </td>
                  <td>
                    <a class="table-title" href="/gallery/<%= item.slug %>" target="_blank" rel="noopener"><%= item.title %></a>
                    <% if (item.caption) { %><span class="muted"><%= item.caption %></span><% } %>
                  </td>
                  <td class="nowrap">
                    <span class="badge badge-article"><%= item.mediaCount %> <%= item.mediaCount === 1 ? 'item' : 'items' %></span>
                  </td>
                  <td><%= item.eventTitle || '—' %></td>
                  <td class="nowrap"><%= new Date(item.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                  <td class="col-actions">
                    <%- include('../partials/row-actions', { editUrl: `/admin/gallery/${item.id}/edit`, deleteUrl: `/admin/gallery/${item.id}/delete`, confirmMsg: 'Delete this album and everything in it?' }) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <%- include('../../partials/pagination', { pagination }) %>
      <% } %>
    </div>

<%- include('../foot') %>
