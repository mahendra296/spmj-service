# Server
PORT=5000
NODE_ENV=development

# CORS — the Frontend origin allowed to make credentialed requests
FRONTEND_ORIGIN=http://localhost:5173

# JWT access / refresh token secrets — override these in production
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# PostgreSQL database
POSTGRES_DATABASE_URL=postgresql://postgres:root@localhost:5432/spmjdb

# Seed credentials (used by drizzle/seed.js)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me
USER_EMAIL=user@example.org
USER_PASSWORD=change-me

# Razorpay (optional — donations degrade gracefully when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
